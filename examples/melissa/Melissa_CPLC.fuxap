        "svgcontent": "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" width=\"1740\" height=\"1000\" viewBox=\"0 0 1740 1000\"><rect width=\"1740\" height=\"1000\" fill=\"#e9eef3\"/><g id=\"MEL_overview_title\" type=\"svg-ext-shapes\"><text x=\"30\" y=\"48\" font-size=\"28\" fill=\"#294b63\" font-family=\"Segoe UI,Arial,sans-serif\">Εγκατάσταση</text></g><g id=\"MEL_overview_rotation\" type=\"svg-ext-shapes\"><rect x=\"1470\" y=\"20\" width=\"235\" height=\"42\" rx=\"7\" fill=\"#e3eef6\" stroke=\"#9eb8ca\"/><text x=\"1587.5\" y=\"47\" text-anchor=\"middle\" fill=\"#294b63\" font-size=\"16\" font-family=\"Segoe UI,Arial\">Περιστροφή 180°</text></g><g id=\"MEL_overview_kpi_waiting\" type=\"svg-ext-shapes\"><rect x=\"290\" y=\"12\" width=\"270\" height=\"86\" rx=\"10\" fill=\"#ffffff\" stroke=\"#b8c7d2\"/></g><g id=\"MEL_overview_kpi_value_waiting_label\" type=\"svg-ext-shapes\"><text x=\"305\" y=\"38\" font-size=\"15\" fill=\"#526c7f\" font-family=\"Segoe UI,Arial,sans-serif\">Σε αναμονή</text></g><g id=\"MEL_overview_kpi_value_waiting\" type=\"svg-ext-value\"><text x=\"305\" y=\"69\" fill=\"#294b63\" font-size=\"21\" font-family=\"Segoe UI,Arial\">—</text></g><g id=\"MEL_overview_kpi_transit\" type=\"svg-ext-shapes\"><rect x=\"575\" y=\"12\" width=\"270\" height=\"86\" rx=\"10\" fill=\"#ffffff\" stroke=\"#b8c7d2\"/></g><g id=\"MEL_overview_kpi_value_transit_label\" type=\"svg-ext-shapes\"><text x=\"590\" y=\"38\" font-size=\"15\" fill=\"#526c7f\" font-family=\"Segoe UI,Arial,sans-serif\">Σε διακίνηση AGV</text></g><g id=\"MEL_overview_kpi_value_transit\" type=\"svg-ext-value\"><text x=\"590\" y=\"69\" fill=\"#294b63\" font-size=\"21\" font-family=\"Segoe UI,Arial\">—</text></g><g id=\"MEL_overview_kpi_wrapper\" type=\"svg-ext-shapes\"><rect x=\"860\" y=\"12\" width=\"270\" height=\"86\" rx=\"10\" fill=\"#ffffff\" stroke=\"#b8c7d2\"/></g><g id=\"MEL_overview_kpi_value_wrapper_label\" type=\"svg-ext-shapes\"><text x=\"875\" y=\"3